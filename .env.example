# Pardais Party Admin — only these four production variables are needed.
# Do not put ADMIN_PASSWORD or ADMIN_AUTH_SECRET into frontend-exposed VITE_* variables.

VITE_API_URL=https://api.pardaisparty.soulverseapps.com
ADMIN_EMAILS=your-admin-email@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
ADMIN_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
