# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# For production custom domain mapping: https://pardaisparty.soulverseapps.com
APP_URL="https://pardaisparty.soulverseapps.com"

# VITE_API_URL: The API base URL for the admin and client applets
# Set to "https://api.pardaisparty.soulverseapps.com" for production custom domain mapping.
VITE_API_URL="https://api.pardaisparty.soulverseapps.com"

# Cloudflare R2 Storage Configuration for Reels & Stories
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME="pardaisparty-reels"
R2_PUBLIC_URL=

# Agora Configuration
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=


# Resend Email API for Pardais Party OTP
# Create the key in the Resend dashboard and store it in Railway as a secret.
RESEND_API_KEY=
# Use onboarding@resend.dev until a sending domain is verified in Resend.
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="Pardais Party"
